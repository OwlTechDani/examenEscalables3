{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "notas": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "outputPath": "dist/notas" },
          "configurations": { "development": { "optimization": false, "sourceMap": true } }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "notas:build:development", "host": "127.0.0.1" } },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json" } }
      }
    }
  },
  "cli": { "analytics": false }
}
