{
  "compilerOptions": {
    "target": "ES2022", "module": "preserve", "moduleResolution": "bundler", "strict": true,
    "experimentalDecorators": true, "skipLibCheck": true, "isolatedModules": true,
    "lib": ["ES2022", "DOM"]
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*.ts"], "exclude": ["src/**/*.spec.ts"]
}
